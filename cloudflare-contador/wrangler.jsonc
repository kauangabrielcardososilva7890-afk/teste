{
  "name": "digicopy-contador-uso",
  "main": "src/index.js",
  "compatibility_date": "2025-11-12",
  "vars": {
    // v5.23.5 — já vem preenchido de fábrica: ID da conta e UUID do banco do
    // sistema. São identificadores (não segredos); o segredo de verdade é só o
    // CF_API_TOKEN, que vive no cofre. Zero edição manual antes do deploy.
    "ACCOUNT_ID": "f6e5851c871c92c55c92faa2de33b8ef",
    "D1_NOME": "digicopy-erp"
  },
  // v5.23.4 — dono pediu SEM cronômetro: mede só quando ele abre a tela de
  // Backup/Nuvem do sistema (o app chama /v1/medir na hora). Lista vazia =
  // o próximo deploy REMOVE o agendamento de 15 em 15 min.
  "triggers": { "crons": [] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "digicopy-erp",
      "database_id": "b6c32346-d6d5-475a-b9c3-40782b525bae"
    }
  ]
}
